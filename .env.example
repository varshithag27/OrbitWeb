# ---- Flask ----
SECRET_KEY=change-this-to-a-long-random-string
# 0.0.0.0 lets other devices on the same network open the app
HOST=0.0.0.0
PORT=5000

# ---- MongoDB ----
# Local:      mongodb://localhost:27017/
# Atlas free: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=fbauth_db

# ---- Email OTP (SMTP) ----
# For Gmail: enable 2FA on the account, then create an "App Password"
# at https://myaccount.google.com/apppasswords and use it below (NOT
# your normal Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=youraccount@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_SENDER_NAME=MyApp Security

# ---- SMS OTP (Twilio) ----
# Sign up at https://www.twilio.com/try-twilio (free trial gives you
# a real trial number + credits). Leave blank to disable SMS OTP and
# use email-only verification.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- OTP settings ----
OTP_EXPIRY_MINUTES=5
